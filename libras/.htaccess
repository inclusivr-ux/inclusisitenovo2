# .htaccess da pasta /libras/ (servidor Apache, como o da HostGator). O construir.mjs copia este arquivo para dist/.htaccess.

# tipos de arquivo
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/octet-stream .vrm
  AddType image/webp .webp
  AddType application/json .json
  AddType text/javascript .js
</IfModule>

# compressão: a Aia (.vrm) cai de 4,25 MB para 3,06 MB; o motor (.js) de 1,2 MB para 329 KB
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/json application/wasm application/octet-stream
</IfModule>

# cache: os pedaços com código no nome (chunks/) nunca mudam; o resto pode mudar a cada versão
<IfModule mod_headers.c>
  <FilesMatch "\.(js|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(vrm|wasm|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#/chunks/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
